# ─── server/api-gateway/.env.example

# 数据库
DATABASE_URL="postgresql://user:password@localhost:5432/shrimptank?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-change-in-production"

# AES-256 加密密钥（用于加密存储的 API Key，生产环境必须修改）
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"

# CORS 允许来源（逗号分隔，默认允许所有）
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# 服务端口
PORT=3000

# 节点环境
NODE_ENV=development

# ── 手机号/短信配置 ──
SMS_PROVIDER=aliyun           # 短信服务商: aliyun | tencent | test
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=NexusOrigin     # 短信签名
SMS_TEMPLATE_CODE=SMS_123456  # 短信模板ID

# ── 微信开放平台配置 ──
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_OPEN_REDIRECT_URI=http://localhost:5173/auth/wechat-callback

# ── JWT增强 ──
JWT_REFRESH_SECRET=your-refresh-secret-here-change-in-production
JWT_REFRESH_EXPIRES_IN=7d