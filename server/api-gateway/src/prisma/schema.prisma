// ─── server/api-gateway/prisma/schema.prisma ──────────────
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  avatar       String?
  bio          String?
  credits      Float    @default(0)
  reputation   Int      @default(0)
  creatorLevel Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  Capability    Capability[]
  posts         Post[]
  comments      Comment[]
  tokenUsages   TokenUsage[]
  purchases     Purchase[]
  agentServices AgentService[]
  agentTasks    AgentTask[]    @relation("Client")
  providedTasks AgentTask[]    @relation("Provider")
  reviews       Review[]
  agents        Agent[]
  a2Atasks      A2ATask[]
  commentLikes  CommentLike[]
  rechargeLogs  RechargeLog[]
}

model Agent {
  id            String      @id @default(cuid())
  name          String
  description   String
  version       String
  endpoint      String // Agent 的 A2A 端点 URL
  capabilities  Json? // 能力列表（如：["text-generation", "code-review"]）
  status        AgentStatus @default(ONLINE)
  healthCheck   String? // 健康检查端点
  lastHeartbeat DateTime?
  ownerId       String
  owner         User        @relation(fields: [ownerId], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  a2Atasks      A2ATask[]
}

enum AgentStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

model Capability {
  id          String      @id @default(cuid())
  name        String
  description String
  version     String
  price       Float       @default(0)
  priceType   PriceType   @default(FREE)
  downloads   Int         @default(0)
  rating      Float       @default(0)
  status      SkillStatus @default(PENDING)
  protocol    String      @default("mcp-tool") // mcp-tool | a2a-service | openclaw-native
  framework   String      @default("any") // openclaw, langgraph, crewai, generic

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  manifest   Json
  packageUrl String?
  sourceCode String? // 可选源代码URL

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]
  reviews   Review[]
  auditLogs AuditLog[]
}

model AuditLog {
  id           String     @id @default(cuid())
  capabilityId String
  capability   Capability @relation(fields: [capabilityId], references: [id])
  action       String // uploaded, approved, rejected, suspended
  reason       String?
  performedBy  String
  createdAt    DateTime   @default(now())
}

enum PriceType {
  FREE
  ONE_TIME
  SUBSCRIPTION
}

enum SkillStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model A2ATask {
  id          String     @id @default(cuid())
  clientId    String // 发布任务的用户 ID
  agentId     String // 目标 Agent ID
  description String     @db.Text
  status      TaskStatus @default(PENDING)
  bid         Float? // 竞标价格（信用点）
  result      String?    @db.Text // 任务执行结果
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  completedAt DateTime?
  client      User       @relation(fields: [clientId], references: [id])
  agent       Agent      @relation(fields: [agentId], references: [id])
}

model Purchase {
  id      String  @id @default(cuid())
  userId  String
  skillId String
  amount  Float
  txHash  String?

  user       User       @relation(fields: [userId], references: [id])
  Capability Capability @relation(fields: [skillId], references: [id])

  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  rating    Int
  content   String?
  createdAt DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id])
  Capability Capability @relation(fields: [skillId], references: [id])
}

model Post {
  id       String       @id @default(cuid())
  title    String
  content  String       @db.Text
  category PostCategory
  tags     String[]
  views    Int          @default(0)
  likes    Int          @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PostCategory {
  TUTORIAL
  QUESTION
  SHOWCASE
  DISCUSSION
  BUG
}

model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  comment Comment @relation(fields: [commentId], references: [id])

  @@unique([userId, commentId])
}

model Comment {
  id      String @id @default(cuid())
  content String @db.Text
  likes   Int    @default(0)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  postId String
  post   Post   @relation(fields: [postId], references: [id])

  parentId String?
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("CommentReplies")

  createdAt    DateTime      @default(now())
  commentLikes CommentLike[]
}

model TokenUsage {
  id           String  @id @default(cuid())
  userId       String
  modelName    String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  skillId      String?
  protocol     String  @default("llm-call")

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AgentTask {
  id          String     @id @default(cuid())
  clientId    String
  providerId  String?
  description String     @db.Text
  status      TaskStatus @default(PENDING)
  bid         Float?
  proofHash   String?

  client   User  @relation("Client", fields: [clientId], references: [id])
  provider User? @relation("Provider", fields: [providerId], references: [id])

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

enum TaskStatus {
  PENDING
  ACCEPTED
  EXECUTING
  COMPLETED
  DISPUTED
}

model AgentService {
  id           String  @id @default(cuid())
  providerId   String
  skillId      String
  pricePerTask Float
  availability Boolean @default(true)

  provider User @relation(fields: [providerId], references: [id])

  createdAt DateTime @default(now())
}

model RechargeLog {
  id        String   @id @default(cuid())
  userId    String
  amount    Float // 充值金额（美元）
  credits   Float // 获得的信用点
  method    String // 充值方式：alipay, wechat, paypal
  status    String   @default("completed") // completed, failed, pending
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
